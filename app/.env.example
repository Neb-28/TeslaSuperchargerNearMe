NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# In production, point this to a self-hosted or cached OpenStreetMap-compatible tile endpoint.
# Google AdSense. Publisher ID looks like ca-pub-1234567890123456; the slot ID comes from the
# responsive "Display ad" unit you create in AdSense for the station page. Leave blank to hide ads.
# RAIL is a second responsive "Display ad" unit for the desktop side ads (shown 300×600 or 160×600).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_STATION=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
# Password for /admin (approve and add #1 Featured listings). Use a long random value.
ADMIN_PASSWORD=
# Contact address on About, Contact and Privacy. Optional: defaults to info@greenstartech.io (lib/site.ts).
CONTACT_EMAIL=
# Supabase (Postgres + PostGIS). URL and anon key are public; the service role key and
# DATABASE_URL are server-only secrets. DATABASE_URL = the "Transaction pooler" connection string.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Route planner (driving routes and address search): openrouteservice.org, free key. Server-only.
# ORS_BASE_URL is optional, for a self-hosted openrouteservice later.
ORS_API_KEY=
ORS_BASE_URL=
# Import only (scripts/import-fast-chargers.mjs): free key from https://developer.nlr.gov/signup/
# for other networks' fast chargers. Without it the import uses the rate-limited DEMO_KEY.
NLR_API_KEY=
# Sentry (error monitoring). The DSN is public: it only lets the site send errors in. Sentry is
# off until it's set. ORG/PROJECT are the slugs from sentry.io; the auth token is secret and only
# used at build time to upload source maps (readable stack traces).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend API key. Supabase sends sign-in emails through it (supabase/config.toml, pushed with
# npx supabase config push), and the site emails Contact page messages to CONTACT_EMAIL with it
# (lib/contactEmail.ts), so it's also needed on Vercel. Secret, server-only.
RESEND_API_KEY=
